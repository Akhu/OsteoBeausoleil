---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  minutesRead: number;
}

const { post, minutesRead } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, image } =
  post.data;

const dateFormatted = new Date(pubDate).toLocaleDateString(undefined, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const updatedFormatted = updatedDate
  ? new Date(updatedDate).toLocaleDateString(undefined, {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout
  pageTitle={title}
  metaDescription={description}
  metaTags={tags}
  metaImage={image}
>
  <article
    itemscope
    itemtype="https://schema.org/Article"
    class="max-w-3xl mx-auto"
  >
    <!-- Back link -->
    <a
      href="/blog/1/"
      class="inline-flex items-center gap-1 text-sm text-brand-600 dark:text-brand-400 hover:underline mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
          clip-rule="evenodd"
        ></path>
      </svg>
      Tous les articles
    </a>

    <!-- Article header -->
    <header class="mb-10">
      <h1 itemprop="name" class="text-3xl sm:text-4xl font-title font-bold leading-tight mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
        <span itemprop="author">{author}</span>
        <span aria-hidden="true">·</span>
        <time itemprop="datePublished" datetime={pubDate.toISOString()}>
          {dateFormatted}
        </time>
        {
          updatedFormatted && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Mis à jour le{" "}
                <time itemprop="dateModified" datetime={updatedDate!.toISOString()}>
                  {updatedFormatted}
                </time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>~{minutesRead} min de lecture</span>
      </div>

      <!-- Description callout -->
      <div class="mt-6 px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm italic">
        {description}
      </div>
    </header>

    <!-- Hero image -->
    {
      image && (
        <img
          src={image}
          alt={title}
          class="w-full rounded-2xl shadow-xl mb-10 object-cover aspect-video"
        />
      )
    }

    <!-- Article body -->
    <div
      itemprop="articleBody"
      class="prose prose-slate dark:prose-invert
             prose-headings:font-title prose-headings:tracking-tight
             prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-a:no-underline hover:prose-a:underline
             prose-img:rounded-xl prose-img:shadow-lg prose-img:mx-auto
             prose-code:before:content-none prose-code:after:content-none
             max-w-none"
    >
      <slot />
    </div>

    <!-- Tags footer -->
    {
      tags && tags.length > 0 && (
        <footer class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class="text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-brand-100 hover:text-brand-700 dark:hover:bg-brand-950 dark:hover:text-brand-300 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </footer>
      )
    }
  </article>
</BaseLayout>
