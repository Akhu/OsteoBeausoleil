---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/blog/PostCard.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const sorted = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  // 9 posts per page
  return paginate(sorted, { pageSize: 9 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<BaseLayout
  pageTitle="Blog"
  metaDescription="Tous les articles du blog."
>
  <div class="py-12">
    <h1 class="text-3xl sm:text-4xl font-title font-bold mb-3 text-slate-900 dark:text-white">
      Blog
    </h1>
    <p class="text-slate-500 dark:text-slate-400 mb-12">
      {page.total} article{page.total > 1 ? "s" : ""}
    </p>

    {
      page.data.length === 0 ? (
        <p class="text-slate-400">Aucun article pour le moment.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.data.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              url={`/blog/${post.slug}/`}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      )
    }

    <!-- Pagination -->
    {
      (page.url.prev || page.url.next) && (
        <nav
          class="flex items-center justify-between mt-16 pt-8 border-t border-slate-200 dark:border-slate-800"
          aria-label="Pagination"
        >
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="px-4 py-2 rounded-full border border-slate-300 dark:border-slate-700 text-sm
                     text-slate-700 dark:text-slate-300 hover:border-brand-500 transition-colors"
            >
              ← Page précédente
            </a>
          ) : (
            <span />
          )}

          <span class="text-sm text-slate-400">
            Page {page.currentPage} / {page.lastPage}
          </span>

          {page.url.next ? (
            <a
              href={page.url.next}
              class="px-4 py-2 rounded-full border border-slate-300 dark:border-slate-700 text-sm
                     text-slate-700 dark:text-slate-300 hover:border-brand-500 transition-colors"
            >
              Page suivante →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
