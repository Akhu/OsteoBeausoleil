---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Page introuvable" metaDescription="Cette page n'existe pas.">
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center gap-6 py-20">
    <p class="text-8xl font-title font-bold text-brand-200 dark:text-brand-900 select-none">
      404
    </p>
    <h1 class="text-2xl font-title font-semibold text-slate-900 dark:text-white">
      Page introuvable
    </h1>
    <p class="text-slate-500 dark:text-slate-400 max-w-sm">
      La page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <a
      href="/"
      class="px-6 py-3 rounded-full bg-brand-600 text-white font-medium hover:bg-brand-700 transition-colors"
    >
      Retour à l'accueil
    </a>
  </div>
</BaseLayout>
