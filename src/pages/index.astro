---
import BaseLayout from "@layouts/BaseLayout.astro";
import siteConfig from "@data/site.config";
---

<BaseLayout
  pageTitle="Ostéo Beausoleil — Ostéopathe DO à Aix-en-Provence"
  metaDescription="Cabinet d'ostéopathie à Aix-en-Provence. Consultations adultes, enfants, nourrissons, femmes enceintes. Praticienne diplômée DO. Prise de RDV en ligne via Doctolib."
>

  <!-- Scroll progress bar -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- ============================================================
       HERO
  ============================================================= -->
  <section
    id="hero"
    class="relative overflow-hidden min-h-screen flex items-center"
    style="background: linear-gradient(160deg, #faf9f7 0%, #f4f9f4 40%, #e3f0e4 100%);"
  >
    <!-- Parallax blobs -->
    <div
      class="parallax-blob pointer-events-none absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full opacity-40"
      style="background: radial-gradient(circle, #c4e0c6, transparent 70%);"
    ></div>
    <div
      class="parallax-blob pointer-events-none absolute bottom-0 -left-32 w-[450px] h-[450px] rounded-full opacity-30"
      style="background: radial-gradient(circle, #9cc89f, transparent 70%);"
    ></div>

    <div class="relative max-w-screen-xl mx-auto px-6 sm:px-10 py-24 lg:py-32 w-full">
      <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">

        <!-- Text block -->
        <div class="flex-1 flex flex-col gap-7" data-reveal>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 self-start px-4 py-2 rounded-full bg-brand-100 border border-brand-200">
            <span class="w-2 h-2 rounded-full bg-brand-500 flex-shrink-0"></span>
            <span class="text-sm font-medium text-brand-700 tracking-wide">Diplômée D.O. — Consultations à Aix-en-Provence</span>
          </div>

          <h1 class="font-title text-5xl sm:text-6xl lg:text-7xl leading-[1.1] text-brand-900">
            Retrouvez<br />
            <span class="italic text-brand-600">l'équilibre</span><br />
            de votre corps
          </h1>

          <p class="text-lg text-slate-600 leading-relaxed max-w-lg">
            L'ostéopathie est une approche globale et douce qui libère les tensions, soulage la douleur et favorise votre bien-être. Je vous accompagne avec écoute et bienveillance, à chaque étape de votre vie.
          </p>

          <div class="flex flex-wrap gap-4 mt-2">
            <a
              href="https://www.doctolib.fr/osteopathe/aix-en-provence/osteo-beausoleil"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-magnetic inline-flex items-center gap-2 px-8 py-4 rounded-full bg-brand-500 text-white font-medium text-base
                     hover:bg-brand-600 active:bg-brand-700 transition-colors shadow-md"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Prendre rendez-vous
            </a>
            <a
              href="#osteopathie"
              class="btn-magnetic inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-brand-300 text-brand-700 font-medium text-base
                     hover:bg-brand-50 transition-colors"
            >
              Découvrir l'ostéopathie
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>

          <!-- Quick trust signals -->
          <div class="flex flex-wrap gap-3 mt-1">
            <span class="text-sm px-3 py-1.5 rounded-full bg-white border border-brand-200 text-slate-600">📍 Aix-en-Provence, 13100</span>
            <span class="text-sm px-3 py-1.5 rounded-full bg-white border border-brand-200 text-slate-600">📞 04 42 67 31 85</span>
            <span class="text-sm px-3 py-1.5 rounded-full bg-white border border-brand-200 text-slate-600">🌿 10 ans d'expérience</span>
          </div>
        </div>

        <!-- Portrait placeholder -->
        <div class="flex-shrink-0" data-reveal style="transition-delay:0.2s;">
          <div class="relative w-72 h-80 sm:w-80 sm:h-96 lg:w-96 lg:h-[440px]">
            <!-- Decorative rings -->
            <div class="absolute inset-0 rounded-[40%_60%_55%_45%/50%_45%_55%_50%] border-2 border-brand-300 scale-105 opacity-50"></div>
            <div class="absolute inset-0 rounded-[40%_60%_55%_45%/50%_45%_55%_50%] border border-brand-200 scale-110 opacity-30"></div>
            <!-- Portrait placeholder -->
            <div
              class="w-full h-full rounded-[40%_60%_55%_45%/50%_45%_55%_50%] overflow-hidden shadow-2xl"
              style="background: linear-gradient(160deg, #c4e0c6 0%, #6daa72 100%);"
            >
              <img
                src="https://placehold.co/400x440/c4e0c6/4d8f52?text=Photo\nPraticienne"
                alt="Claire Beausoleil, ostéopathe DO à Aix-en-Provence"
                class="w-full h-full object-cover"
                width="400"
                height="440"
                loading="eager"
              />
            </div>
            <!-- Floating badge -->
            <div class="absolute -bottom-4 -left-6 bg-white rounded-2xl shadow-lg px-4 py-3 border border-brand-100">
              <p class="text-xs text-slate-500 mb-0.5">Diplôme d'État</p>
              <p class="text-sm font-semibold text-brand-800">Ostéopathe D.O.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION — L'OSTÉOPATHIE
  ============================================================= -->
  <section id="osteopathie" class="py-24 px-6 sm:px-10 bg-white">
    <div class="max-w-screen-xl mx-auto">

      <div class="text-center mb-16" data-reveal>
        <p class="text-sm font-medium text-brand-600 tracking-widest uppercase mb-3">Comprendre</p>
        <h2 class="font-title text-4xl sm:text-5xl text-brand-900 mb-6">L'Ostéopathie</h2>
        <div class="w-16 h-0.5 bg-brand-300 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="flex flex-col gap-6" data-reveal>
          <p class="text-lg text-slate-600 leading-relaxed">
            L'ostéopathie est une médecine manuelle qui considère le corps dans sa globalité. Elle part du principe que structure et fonction sont interdépendantes : lorsqu'une zone du corps est en restriction de mobilité, l'ensemble de l'organisme peut en être affecté.
          </p>
          <p class="text-slate-600 leading-relaxed">
            En travaillant sur les fascias, les articulations, les muscles et les viscères, l'ostéopathe cherche à restaurer la liberté de mouvement des tissus et à stimuler les capacités d'auto-régulation du corps. C'est une approche douce, non invasive, qui s'adresse à tous les âges de la vie.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Chaque consultation est unique : je prends le temps d'écouter votre histoire, de comprendre votre mode de vie et vos habitudes, avant d'effectuer un bilan complet. Le traitement s'adapte à vous — pas l'inverse.
          </p>
        </div>

        <!-- Encadré symptômes -->
        <div
          class="rounded-3xl p-8 border border-brand-200"
          style="background: linear-gradient(135deg, #f4f9f4, #e3f0e4);"
          data-reveal
          style="transition-delay: 0.15s;"
        >
          <h3 class="font-title text-2xl text-brand-900 mb-5">L'ostéopathie est-elle faite pour vous ?</h3>
          <p class="text-sm text-slate-600 mb-5">Elle peut vous aider si vous souffrez de :</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-stagger>
            {[
              "Douleurs de dos, cervicales ou lombaires",
              "Maux de tête et migraines",
              "Douleurs articulaires (épaule, hanche, genou)",
              "Troubles digestifs (reflux, transit)",
              "Stress, fatigue chronique, troubles du sommeil",
              "Suites d'opération ou d'accident",
              "Douleurs liées à la grossesse",
              "Troubles ORL récurrents",
              "Coliques et pleurs du nourrisson",
              "Scolioses et troubles posturaux",
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700" data-reveal>
                <svg class="w-4 h-4 text-brand-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION — CONSULTATIONS
  ============================================================= -->
  <section id="consultations" class="py-24 px-6 sm:px-10" style="background: linear-gradient(180deg, #f4f9f4 0%, #faf9f7 100%);">
    <div class="max-w-screen-xl mx-auto">

      <div class="text-center mb-16" data-reveal>
        <p class="text-sm font-medium text-brand-600 tracking-widest uppercase mb-3">Pour tous</p>
        <h2 class="font-title text-4xl sm:text-5xl text-brand-900 mb-4">Consultations</h2>
        <p class="text-slate-500 max-w-xl mx-auto">Chaque profil a ses spécificités. Je m'adapte à votre situation pour vous offrir le soin le plus pertinent.</p>
        <div class="w-16 h-0.5 bg-brand-300 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger>

        <!-- Adultes -->
        <div
          class="group rounded-3xl p-7 border border-brand-100 bg-white hover:border-brand-300 hover:shadow-lg transition-all duration-300"
          data-reveal
        >
          <div class="w-12 h-12 rounded-2xl bg-brand-100 flex items-center justify-center mb-5 group-hover:bg-brand-200 transition-colors">
            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="font-title text-xl text-brand-900 mb-2">Adultes</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">Douleurs musculo-squelettiques, troubles viscéraux, stress, récupération post-opératoire. Bilan complet et traitement adapté à votre mode de vie.</p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <span class="text-sm text-slate-500">⏱ 45–60 min</span>
            <span class="text-lg font-semibold text-brand-600">60 €</span>
          </div>
        </div>

        <!-- Enfants & Adolescents -->
        <div
          class="group rounded-3xl p-7 border border-brand-100 bg-white hover:border-brand-300 hover:shadow-lg transition-all duration-300"
          data-reveal
        >
          <div class="w-12 h-12 rounded-2xl bg-brand-100 flex items-center justify-center mb-5 group-hover:bg-brand-200 transition-colors">
            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </div>
          <h3 class="font-title text-xl text-brand-900 mb-2">Enfants & Adolescents</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">Scolioses, troubles posturaux, maux de tête, douleurs de croissance. Prise en charge douce adaptée à chaque tranche d'âge.</p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <span class="text-sm text-slate-500">⏱ 45 min</span>
            <span class="text-lg font-semibold text-brand-600">55 €</span>
          </div>
        </div>

        <!-- Nourrissons -->
        <div
          class="group rounded-3xl p-7 border border-brand-100 bg-white hover:border-brand-300 hover:shadow-lg transition-all duration-300"
          data-reveal
        >
          <div class="w-12 h-12 rounded-2xl bg-brand-100 flex items-center justify-center mb-5 group-hover:bg-brand-200 transition-colors">
            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="font-title text-xl text-brand-900 mb-2">Nourrissons</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">Coliques, régurgitations, torticolis, plagiocéphalie, difficultés d'allaitement. Gestes très doux, adaptés aux premiers mois de vie.</p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <span class="text-sm text-slate-500">⏱ 30–45 min</span>
            <span class="text-lg font-semibold text-brand-600">55 €</span>
          </div>
        </div>

        <!-- Femmes enceintes -->
        <div
          class="group rounded-3xl p-7 border border-brand-100 bg-white hover:border-brand-300 hover:shadow-lg transition-all duration-300"
          data-reveal
        >
          <div class="w-12 h-12 rounded-2xl bg-brand-100 flex items-center justify-center mb-5 group-hover:bg-brand-200 transition-colors">
            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h3 class="font-title text-xl text-brand-900 mb-2">Femmes enceintes</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">Douleurs lombaires, sciatiques, pubalgies, nausées. Accompagnement tout au long de la grossesse et en post-partum.</p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <span class="text-sm text-slate-500">⏱ 45–60 min</span>
            <span class="text-lg font-semibold text-brand-600">60 €</span>
          </div>
        </div>

        <!-- Sportifs -->
        <div
          class="group rounded-3xl p-7 border border-brand-100 bg-white hover:border-brand-300 hover:shadow-lg transition-all duration-300 sm:col-span-2 lg:col-span-1"
          data-reveal
        >
          <div class="w-12 h-12 rounded-2xl bg-brand-100 flex items-center justify-center mb-5 group-hover:bg-brand-200 transition-colors">
            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="font-title text-xl text-brand-900 mb-2">Sportifs</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">Tendinites, entorses, récupération musculaire, prévention des blessures. Optimisez vos performances et récupérez plus vite.</p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <span class="text-sm text-slate-500">⏱ 45–60 min</span>
            <span class="text-lg font-semibold text-brand-600">65 €</span>
          </div>
        </div>

        <!-- Doctolib CTA card -->
        <div
          class="rounded-3xl p-7 lg:col-span-3 sm:col-span-2"
          style="background: linear-gradient(135deg, #4d8f52, #3a7040);"
          data-reveal
        >
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <div class="flex-1">
              <h3 class="font-title text-2xl text-white mb-2">Prêt(e) à prendre soin de vous ?</h3>
              <p class="text-brand-200 text-sm leading-relaxed">Réservez votre consultation en ligne, 24h/24, directement sur Doctolib. Créneaux disponibles du lundi au samedi.</p>
            </div>
            <a
              href="https://www.doctolib.fr/osteopathe/aix-en-provence/osteo-beausoleil"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-magnetic inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white text-brand-700 font-semibold text-sm
                     hover:bg-brand-50 transition-colors shadow-md whitespace-nowrap flex-shrink-0"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Réserver sur Doctolib
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION — À PROPOS
  ============================================================= -->
  <section id="apropos" class="py-24 px-6 sm:px-10 bg-white">
    <div class="max-w-screen-xl mx-auto">

      <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">

        <!-- Portrait -->
        <div class="flex-shrink-0 relative" data-reveal>
          <div class="w-72 h-80 lg:w-80 lg:h-96 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="https://placehold.co/360x420/e3f0e4/2d5732?text=Claire\nBeau-\nsoleil"
              alt="Claire Beausoleil, ostéopathe D.O."
              class="w-full h-full object-cover"
              width="360"
              height="420"
              loading="lazy"
            />
          </div>
          <!-- Floating accent -->
          <div class="absolute -bottom-6 -right-6 bg-brand-500 rounded-2xl shadow-lg px-5 py-4 text-white text-center">
            <p class="text-2xl font-title font-bold">10</p>
            <p class="text-xs text-brand-200">ans d'expérience</p>
          </div>
          <!-- Decorative dot -->
          <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full border-2 border-brand-300 opacity-60"></div>
        </div>

        <!-- Text -->
        <div class="flex-1" data-reveal style="transition-delay: 0.15s;">
          <p class="text-sm font-medium text-brand-600 tracking-widest uppercase mb-4">À propos</p>
          <h2 class="font-title text-4xl sm:text-5xl text-brand-900 mb-6">
            Bonjour, je suis<br />
            <span class="italic">Claire Beausoleil</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-lg mb-4">
            Diplômée du Collège Ostéopathique de Lyon et titulaire du titre D.O. reconnu par le Ministère de la Santé, j'exerce à Aix-en-Provence depuis plus de dix ans avec la même conviction : chaque corps mérite une écoute attentive et un soin sur-mesure.
          </p>
          <p class="text-slate-600 leading-relaxed mb-4">
            Formée régulièrement aux techniques viscérales, crâniennes et myofasciales, je puise dans une boîte à outils riche pour trouver l'approche qui vous correspond. Ma philosophie : traiter la cause, pas seulement le symptôme.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8">
            En dehors du cabinet, je pratique le yoga et la randonnée — ce lien au corps et à la nature nourrit profondément ma pratique clinique.
          </p>

          <!-- Chiffres clés -->
          <div class="grid grid-cols-3 gap-6" data-stagger>
            {[
              { num: "10", unit: "ans", label: "d'expérience" },
              { num: "2000+", unit: "", label: "patients accompagnés" },
              { num: "1", unit: "fois/an", label: "formation continue" },
            ].map(stat => (
              <div class="text-center" data-reveal>
                <p class="font-title text-3xl text-brand-600">
                  {stat.num}<span class="text-base text-brand-400 ml-1">{stat.unit}</span>
                </p>
                <p class="text-xs text-slate-500 mt-1">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION — DÉROULEMENT D'UNE SÉANCE
  ============================================================= -->
  <section class="py-24 px-6 sm:px-10" style="background: linear-gradient(180deg, #f4f9f4 0%, #faf9f7 100%);">
    <div class="max-w-screen-xl mx-auto">

      <div class="text-center mb-16" data-reveal>
        <p class="text-sm font-medium text-brand-600 tracking-widest uppercase mb-3">Transparent & rassurant</p>
        <h2 class="font-title text-4xl sm:text-5xl text-brand-900 mb-4">Comment se déroule une séance ?</h2>
        <div class="w-16 h-0.5 bg-brand-300 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
        {[
          {
            num: "01",
            title: "Anamnèse",
            desc: "Nous prenons le temps d'échanger sur vos motifs de consultation, vos antécédents médicaux, votre mode de vie. Cette étape est essentielle pour cerner votre situation dans sa globalité.",
          },
          {
            num: "02",
            title: "Examen",
            desc: "Un bilan postural et des tests ostéopathiques permettent d'identifier les zones en restriction de mobilité. Je cherche la ou les causes de vos symptômes, pas uniquement le site douloureux.",
          },
          {
            num: "03",
            title: "Traitement",
            desc: "Les manipulations sont choisies en fonction de votre profil : techniques structurelles, myofasciales, viscérales ou crâniennes. Tout est adapté à votre sensibilité et à vos préférences.",
          },
          {
            num: "04",
            title: "Bilan & Conseils",
            desc: "En fin de séance, nous faisons le point ensemble. Je vous donne des conseils personnalisés (posture, étirements, habitudes) pour ancrer les bénéfices du traitement dans la durée.",
          },
        ].map(step => (
          <div
            class="relative flex flex-col gap-4 p-7 bg-white rounded-3xl border border-brand-100 shadow-sm"
            data-reveal
          >
            <span class="font-title text-5xl text-brand-100 leading-none select-none">{step.num}</span>
            <h3 class="font-title text-xl text-brand-900 -mt-2">{step.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION — FAQ
  ============================================================= -->
