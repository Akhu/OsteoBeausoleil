---
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
import Hamburger from "./Hamburger.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: rgba(250, 249, 247, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <nav
    class="max-w-screen-xl mx-auto px-6 sm:px-10 flex items-center gap-4 h-16"
    role="navigation"
    aria-label="Navigation principale"
  >
    <!-- Logo / Brand -->
    <Logo />

    <!-- Spacer -->
    <div class="flex-grow"></div>

    <!-- Desktop nav links -->
    <Navigation />

    <!-- Doctolib CTA (desktop) -->
    <a
      href="https://www.doctolib.fr/osteopathe/aix-en-provence/osteo-beausoleil"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden lg:inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-brand-500 text-white text-sm font-medium
             hover:bg-brand-600 transition-colors ml-4"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      Rendez-vous
    </a>

    <!-- Mobile: hamburger -->
    <div class="lg:hidden">
      <Hamburger />
    </div>
  </nav>
</header>

<!-- Spacer so content doesn't sit under the fixed header -->
<div class="h-16" aria-hidden="true"></div>

<style>
  header.scrolled {
    border-bottom: 1px solid rgba(156, 200, 159, 0.3);
    box-shadow: 0 2px 20px rgba(45, 87, 50, 0.06);
  }
</style>
