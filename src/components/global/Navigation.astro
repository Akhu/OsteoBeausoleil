---
import siteConfig from "@data/site.config";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<!-- Full-screen mobile overlay -->
<div
  class="nav-links fixed w-0 h-0 opacity-0 hidden top-0 left-0 right-0 bottom-0 z-50
         bg-white dark:bg-slate-900 backdrop-blur-xl
         lg:block lg:w-auto lg:h-min lg:static lg:opacity-100 lg:z-auto lg:bg-transparent"
>
  <!-- Close button (mobile only) -->
  <button
    class="close-menu absolute right-5 top-5 text-2xl text-slate-500 dark:text-slate-400 lg:hidden
           hover:text-brand-600 transition-colors p-2"
    aria-label="Fermer le menu"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="flex flex-col lg:flex-row justify-center items-center mx-auto h-full gap-1">
    <!-- Logo repeated inside mobile menu -->
    <div class="lg:hidden mb-6">
      <Logo />
    </div>

    {
      siteConfig.navLinks.map((link) => {
        const isActive =
          link.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(link.href.replace("/#", "/"));
        return (
          <a
            href={link.href}
            class:list={[
              "px-4 py-2 rounded-full text-sm font-medium transition-all",
              "text-slate-700 dark:text-slate-300",
              "hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 dark:hover:text-white",
              isActive &&
                "bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }

    <!-- Theme toggle in mobile menu -->
    <div class="lg:hidden mt-6">
      <ThemeToggle />
    </div>
  </div>
</div>
