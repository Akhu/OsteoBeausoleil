---
import siteConfig from "@data/site.config";

const year = new Date().getFullYear();

const socialLinks = Object.entries(siteConfig.social).filter(
  ([, url]) => url !== ""
);

const socialIcons: Record<string, string> = {
  linkedin: "in",
  instagram: "ig",
  twitter: "x",
  github: "gh",
  youtube: "yt",
};
---

<footer class="w-full mt-0" style="background: linear-gradient(180deg, #1a3220 0%, #0d1f13 100%);">
  <div class="max-w-screen-xl mx-auto px-6 sm:px-10 py-16 flex flex-col gap-10">

    <!-- Brand + columns -->
    <div class="flex flex-col sm:flex-row gap-10 justify-between">

      <!-- Brand block -->
      <div class="flex flex-col gap-3 max-w-sm">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6 text-brand-400 flex-shrink-0" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M14 4C14 4 6 8 6 16C6 20.4 9.6 24 14 24C18.4 24 22 20.4 22 16C22 8 14 4 14 4Z" fill="currentColor" opacity="0.3"/>
            <path d="M14 4C14 4 6 8 6 16C6 20.4 9.6 24 14 24C18.4 24 22 20.4 22 16C22 8 14 4 14 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M14 24V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <h2 class="font-title text-xl text-white">{siteConfig.name}</h2>
        </div>
        <p class="text-brand-300 text-sm leading-relaxed">{siteConfig.tagline}</p>
        <p class="text-brand-500 text-xs leading-relaxed">{siteConfig.description}</p>
      </div>

      <!-- Nav links -->
      <nav aria-label="Footer navigation" class="flex flex-col gap-2">
        <p class="text-xs text-brand-600 uppercase tracking-widest font-medium mb-1">Navigation</p>
        {siteConfig.navLinks.map(link => (
          <a href={link.href} class="text-brand-300 text-sm hover:text-white transition-colors">{link.label}</a>
        ))}
      </nav>

      <!-- Contact & RDV -->
      <div class="flex flex-col gap-2">
        <p class="text-xs text-brand-600 uppercase tracking-widest font-medium mb-1">Contact</p>
        {siteConfig.email && (
          <a href={`mailto:${siteConfig.email}`} class="text-brand-300 text-sm hover:text-white transition-colors">
            {siteConfig.email}
          </a>
        )}
        {siteConfig.phone && (
          <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="text-brand-300 text-sm hover:text-white transition-colors">
            {siteConfig.phone}
          </a>
        )}
        {siteConfig.address && <p class="text-brand-500 text-xs leading-relaxed mt-1">{siteConfig.address}</p>}
        <a
          href="https://www.doctolib.fr/osteopathe/aix-en-provence/osteo-beausoleil"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-brand-500 text-white text-xs font-medium
                 hover:bg-brand-400 transition-colors mt-2 w-fit"
        >
          Prendre rendez-vous →
        </a>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-t border-brand-900 pt-8">

      <!-- Social links -->
      {socialLinks.length > 0 && (
        <div class="flex flex-row gap-2">
          {socialLinks.map(([platform, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={platform}
              class="text-brand-500 hover:text-white transition-colors text-xs font-mono uppercase tracking-wider border border-brand-800 hover:border-brand-500 rounded-full px-3 py-1"
            >
              {socialIcons[platform] ?? platform.slice(0, 2)}
            </a>
          ))}
        </div>
      )}

      <!-- Copyright -->
      <p class="text-brand-700 text-xs">
        © {year} {siteConfig.name} · Site par <a
          href="https://pickle-studio.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-brand-400 transition-colors underline underline-offset-2"
        >Pickle Studio</a>
      </p>
    </div>
  </div>
</footer>
