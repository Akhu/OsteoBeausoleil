---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  url: string;
  tags?: string[];
  minutesRead?: number;
  image?: string;
}

const { title, description, pubDate, url, tags, minutesRead, image } =
  Astro.props;

const dateFormatted = new Date(pubDate).toLocaleDateString(undefined, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={url}
  class="group flex flex-col gap-3 p-5 rounded-2xl border border-slate-200 dark:border-slate-800
         hover:border-brand-400 dark:hover:border-brand-700
         hover:shadow-md dark:hover:shadow-brand-950/20
         bg-white dark:bg-slate-900 transition-all duration-200"
>
  {
    image && (
      <img
        src={image}
        alt={title}
        class="w-full rounded-xl object-cover aspect-video mb-1"
        loading="lazy"
      />
    )
  }

  <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500">
    <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
    {minutesRead && (
      <>
        <span aria-hidden="true">·</span>
        <span>~{minutesRead} min</span>
      </>
    )}
  </div>

  <h2
    class="text-lg font-title font-semibold text-slate-900 dark:text-slate-100
           group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors leading-snug"
  >
    {title}
  </h2>

  <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
    {description}
  </p>

  {
    tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-1">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</a>
